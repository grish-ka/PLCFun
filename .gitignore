# --- Gradle ---
.gradle/
**/build/
build
!**/src/**/build/

# Ignore Gradle GUI config & caches
gradle-app.setting
.gradletasknamecache

# --- Java ---
*.class
*.log
*.jar
*.war
*.ear
hs_err_pid*

# IMPORTANT: Do NOT ignore the Gradle Wrapper jar and properties!
# (Must come AFTER *.jar so the ! exception works)
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# --- IDEs (IntelliJ IDEA, Eclipse, VS Code) ---
.idea/
*.iml
*.iws
*.ipr
out/
.settings/
.classpath
.project
.vscode/

